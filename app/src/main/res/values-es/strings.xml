    <string name="macros_help_read_mode_title">Macros · ayuda</string>
    <string name="macros_help_read_mode_block1"><![CDATA[<b>Sequence</b> — Type text and tokens in <b>Macro sequence</b>. Use <b>Insert tokens</b> for modifiers, keys, and delays. Match opening and closing tags (e.g. <tt>&lt;CTRL&gt;</tt> … <tt>&lt;/CTRL&gt;</tt>).]]></string>
    <string name="macros_help_read_mode_block2"><![CDATA[<b>Timing</b> — <b>Send char interval</b> sets delay between keystrokes when the macro runs.]]></string>
    <string name="macros_help_read_mode_block3"><![CDATA[<b>Scheduler</b> — Optional: pick a run time and repeat options. Tap <b>Save</b> when finished.]]></string>
