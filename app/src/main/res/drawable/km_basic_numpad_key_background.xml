<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <!-- KM Basic: locked mouse strip / latched keys use state_selected -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
            <solid android:color="?attr/colorPrimaryContainer" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/key_bg_normal" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/km_basic_numpad_key_stroke" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="45"
                        android:startColor="@color/km_basic_numpad_pattern_soft_light"
                        android:centerColor="@android:color/transparent"
                        android:endColor="@color/km_basic_numpad_pattern_soft_light" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/km_basic_numpad_pattern_soft_shadow"
                        android:centerColor="@android:color/transparent"
                        android:endColor="@color/km_basic_numpad_pattern_soft_shadow" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
