<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- IME capture on: pressed — solid accent (icon uses onPrimaryContainer tint). -->
    <item android:state_pressed="true" android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <!-- KeyMod: pressed — same feedback weight as other strip keys. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <!-- IME capture on: idle — filled container + accent ring. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <!-- KeyMod: idle — neutral fill + accent outline so the slot reads as “special”. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_bg_function" />
            <stroke
                android:width="1.5dp"
                android:color="?attr/colorPrimary" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
