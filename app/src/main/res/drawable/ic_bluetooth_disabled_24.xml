<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="#9E9E9E">
    <!-- Antenna pole -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M432,500 L528,500 L528,880 L432,880 Z"/>
    <!-- Top antenna dot -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M480,440 m-60,0 a60,60 0 1,0 120,0 a60,60 0 1,0 -120,0"/>
    <!-- Left inner signal arc -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:pathData="M380,300 Q240,440 380,580"/>
    <!-- Left outer signal arc -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:pathData="M280,200 Q120,440 280,680"/>
    <!-- Right inner signal arc -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:pathData="M580,300 Q720,440 580,580"/>
    <!-- Right outer signal arc -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:pathData="M680,200 Q840,440 680,680"/>
    <!-- Diagonal slash -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#9E9E9E"
        android:strokeWidth="120"
        android:strokeLineCap="round"
        android:pathData="M160,160 L800,800"/>
</vector>
