<?xml version="1.0" encoding="utf-8"?>
<!-- Icon-only KM Basic keys (e.g. Win / App): follows parent pressed/selected (duplicateParentState). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="?attr/colorOnPrimaryContainer" />
    <item android:state_selected="true" android:color="?attr/colorPrimary" />
    <item android:color="?attr/colorOnSurface" />
</selector>
