<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Generate section (visible before key generation) ── -->
        <LinearLayout
            android:id="@+id/key_generate_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credential_key_name"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/key_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:text="SSH key"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Algorithm (floating label dropdown) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/key_algorithm_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credential_key_algorithm"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/key_algorithm_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Key Size (visible only when RSA is selected) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/key_rsa_size_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credential_key_size"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/key_rsa_size_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Passphrase (optional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credential_key_passphrase_hint"
                app:endIconMode="password_toggle"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/key_passphrase_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Rounds (visible when passphrase is not empty) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/key_rounds_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credential_key_rounds"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/key_rounds_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save passphrase checkbox -->
            <CheckBox
                android:id="@+id/key_save_passphrase_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credential_key_save_passphrase"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- ── Edit section (visible after key generation) ── -->
        <LinearLayout
            android:id="@+id/key_edit_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Name (editable) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credential_key_name"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/key_edit_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Key Info (read-only, algorithm type) with three-dot menu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/credential_key_info"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/key_edit_algorithm_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Three-dot menu for Copy/Reveal private key -->
                <ImageView
                    android:id="@+id/key_edit_algorithm_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/credential_key_options" />

            </LinearLayout>

            <!-- Private Key (inline multi-line display, hidden by default) -->
            <TextView
                android:id="@+id/key_edit_private_key_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tags_input_outline"
                android:padding="12dp"
                android:textSize="11sp"
                android:textIsSelectable="false"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Public Key (one-line by default, expandable via menu) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credential_public_key_title"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/key_edit_public_key_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tags_input_outline"
                    android:padding="12dp"
                    android:textSize="12sp"
                    android:textIsSelectable="false"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Three-dot menu for Copy/Reveal public key -->
                <ImageView
                    android:id="@+id/key_edit_public_key_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/credential_key_options" />

            </LinearLayout>

            <!-- Passphrase (editable) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credential_key_passphrase_hint"
                app:endIconMode="password_toggle"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/key_edit_passphrase_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Export or share public key button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_edit_export_public_key_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/credential_export_public_key"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:icon="@drawable/share_24"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
