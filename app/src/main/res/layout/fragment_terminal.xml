<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/terminal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_background">

    <!-- Top status bar -->
    <LinearLayout
        android:id="@+id/terminal_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/terminal_toolbar_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Left side: connection status and IP address -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/terminal_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terminal_disconnected"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/terminal_host_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right side: Bluetooth icon and disconnect button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Transport type indicator -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_transport_btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="@string/terminal_transport_ble"
                android:textSize="13sp"
                android:visibility="gone"
                app:icon="@drawable/ic_bluetooth_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <!-- Connect/disconnect button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_connect_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/terminal_connect"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Terminal display area -->
    <FrameLayout
        android:id="@+id/terminal_display_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.openterface.terminal.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Connection overlay (shown when disconnected) - kept for backward compatibility -->
        <LinearLayout
            android:id="@+id/terminal_connection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/terminal_background"
            android:visibility="gone"
            android:paddingStart="@dimen/terminal_empty_padding_h"
            android:paddingTop="@dimen/terminal_empty_padding_v"
            android:paddingEnd="@dimen/terminal_empty_padding_h"
            android:paddingBottom="@dimen/terminal_empty_padding_v">

            <ImageView
                android:layout_width="@dimen/terminal_empty_icon_size"
                android:layout_height="@dimen/terminal_empty_icon_size"
                android:src="@drawable/ic_terminal"
                android:tint="@color/text_secondary"
                android:importantForAccessibility="no"
                android:layout_marginBottom="@dimen/terminal_empty_icon_margin_bottom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/top_mode_label_terminal"
                android:textSize="@dimen/terminal_empty_title_size"
                android:textColor="@color/terminal_status_text"
                android:layout_marginBottom="@dimen/terminal_empty_title_margin_bottom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/terminal_empty_content_max_width"
                android:text="@string/top_mode_label_terminal_summary"
                android:textSize="@dimen/terminal_empty_summary_size"
                android:textColor="@color/terminal_status_text"
                android:gravity="center"
                android:layout_marginBottom="@dimen/terminal_empty_summary_margin_bottom" />

            <LinearLayout
                android:id="@+id/terminal_empty_button_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:showDividers="none"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/terminal_demo_ble_btn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="@dimen/terminal_empty_button_width"
                    android:layout_height="@dimen/terminal_empty_button_height"
                    android:text="@string/terminal_demo_ble"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_bluetooth_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/terminal_demo_usb_btn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="@dimen/terminal_empty_button_width"
                    android:layout_height="@dimen/terminal_empty_button_height"
                    android:layout_marginTop="@dimen/terminal_empty_button_gap"
                    android:text="@string/terminal_demo_usb"
                    android:textSize="13sp"
                    android:textColor="@color/terminal_status_text"
                    app:icon="@drawable/ic_usb_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/terminal_status_text" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Keyboard slot: CustomKeyboardView + hidden IME host (revealed when IME toggle requested) -->
    <LinearLayout
        android:id="@+id/terminal_keyboard_slot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- IME host EditText: invisible until IME toggle; system IME floats below the custom keyboard -->
        <EditText
            android:id="@+id/terminal_ime_host"
            android:layout_width="match_parent"
            android:layout_height="@dimen/km_pro_ime_host_height"
            android:visibility="gone"
            android:padding="0dp"
            android:background="@android:color/transparent"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:cursorVisible="false"
            android:textSize="1sp"
            android:textColor="@android:color/transparent"
            android:textColorHint="@android:color/transparent"
            android:contentDescription="@string/km_pro_ime_direct_send_input_a11y"
            android:importantForAutofill="no" />

    </LinearLayout>

</LinearLayout>
