<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/terminal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_background">

    <!-- Top status bar -->
    <LinearLayout
        android:id="@+id/terminal_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/terminal_toolbar_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Left side: submode tabs (hidden for now) -->
        <LinearLayout
            android:id="@+id/terminal_submode_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/terminal_tab_keyboard"
                style="@style/KmProSubmodeTabIcon"
                android:contentDescription="@string/terminal_submode_keyboard"
                android:src="@drawable/ic_km_pro_submode_keyboard" />

            <ImageButton
                android:id="@+id/terminal_tab_compose"
                style="@style/KmProSubmodeTabIcon"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/terminal_submode_compose"
                android:src="@drawable/ic_km_pro_submode_compose" />
        </LinearLayout>

        <!-- Connection status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/terminal_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terminal_disconnected"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/terminal_host_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right side: transport button + connect/disconnect button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Transport type button (e.g. "BLE-Eth Tunnel", "USB ECM Bridge") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_transport_btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:textSize="13sp"
                android:visibility="gone"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <!-- Connect/disconnect button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_connect_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="@string/terminal_connect"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Terminal display area -->
    <FrameLayout
        android:id="@+id/terminal_display_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.openterface.terminal.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Connection overlay (shown when disconnected) - kept for backward compatibility -->
        <LinearLayout
            android:id="@+id/terminal_connection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/terminal_background"
            android:visibility="gone"
            android:paddingStart="@dimen/terminal_empty_padding_h"
            android:paddingTop="@dimen/terminal_empty_padding_v"
            android:paddingEnd="@dimen/terminal_empty_padding_h"
            android:paddingBottom="@dimen/terminal_empty_padding_v">

            <ImageView
                android:layout_width="@dimen/terminal_empty_icon_size"
                android:layout_height="@dimen/terminal_empty_icon_size"
                android:src="@drawable/ic_terminal"
                android:tint="@color/text_secondary"
                android:importantForAccessibility="no"
                android:layout_marginBottom="@dimen/terminal_empty_icon_margin_bottom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/top_mode_label_terminal"
                android:textSize="@dimen/terminal_empty_title_size"
                android:textColor="@color/terminal_status_text"
                android:layout_marginBottom="@dimen/terminal_empty_title_margin_bottom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/terminal_empty_content_max_width"
                android:text="@string/top_mode_label_terminal_summary"
                android:textSize="@dimen/terminal_empty_summary_size"
                android:textColor="@color/terminal_status_text"
                android:gravity="center"
                android:layout_marginBottom="@dimen/terminal_empty_summary_margin_bottom" />

        </LinearLayout>

    </FrameLayout>

    <!-- Keyboard slot: CustomKeyboardView + hidden IME host (revealed when IME toggle requested) -->
    <LinearLayout
        android:id="@+id/terminal_keyboard_slot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- IME host EditText: invisible until IME toggle; system IME floats below the custom keyboard -->
        <EditText
            android:id="@+id/terminal_ime_host"
            android:layout_width="match_parent"
            android:layout_height="@dimen/km_pro_ime_host_height"
            android:visibility="gone"
            android:padding="0dp"
            android:background="@android:color/transparent"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:cursorVisible="false"
            android:textSize="1sp"
            android:textColor="@android:color/transparent"
            android:textColorHint="@android:color/transparent"
            android:contentDescription="@string/km_pro_ime_direct_send_input_a11y"
            android:importantForAutofill="no" />

    </LinearLayout>

    <!-- Compose editor container (shown in compose submode, mutually exclusive with keyboard_slot) -->
    <!-- Uses weight to share space with terminal, contains shortcut strip inside -->
    <LinearLayout
        android:id="@+id/terminal_compose_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/background_light"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <!-- Editor: fills available space above buttons -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <EditText
                android:id="@+id/terminal_compose_editor"
                style="@style/Widget.KeyCmd.BasicComposeEditor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/terminal_compose_hint"
                android:minHeight="80dp"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="1"
                android:scrollbars="vertical"
                android:gravity="top|start"
                android:importantForAutofill="no" />

        </androidx.core.widget.NestedScrollView>

        <!-- Action buttons row - same layout as KM Pro -->
        <LinearLayout
            android:id="@+id/terminal_compose_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_compose_clear"
                style="@style/Widget.KeyCmd.BasicComposeActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/terminal_compose_clear_cd"
                android:text=""
                app:icon="@drawable/ic_compose_clear_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_compose_library"
                style="@style/Widget.KeyCmd.BasicComposeActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/terminal_compose_library_cd"
                android:text=""
                app:icon="@drawable/ic_bookmark_star_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_compose_save"
                style="@style/Widget.KeyCmd.BasicComposeActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/ime_saved_text_save_cd"
                android:text=""
                app:icon="@drawable/ic_top_save"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_compose_send"
                style="@style/Widget.KeyCmd.BasicComposeActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
                android:gravity="center"
                android:contentDescription="@string/terminal_compose_send"
                android:text=""
                app:icon="@drawable/ic_compose_send_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Shortcut strip (same as full keyboard) -->
        <FrameLayout
            android:id="@+id/terminal_compose_shortcut_strip_wrap"
            android:layout_width="match_parent"
            android:layout_height="@dimen/compose_shortcut_strip_height"
            android:layout_marginStart="@dimen/basic_compose_km_pro_shortcut_strip_horizontal_outdent"
            android:layout_marginEnd="@dimen/basic_compose_km_pro_shortcut_strip_horizontal_outdent"
            android:layout_marginTop="6dp">

            <com.openterface.keymod.CustomKeyboardView
                android:id="@+id/terminal_compose_shortcut_strip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="@dimen/keyboard_outer_padding_top"
                android:paddingBottom="@dimen/keyboard_outer_padding_bottom"
                android:keyBackground="@drawable/key_background"
                android:theme="@style/ButtonTheme"
                app:showGuiHidKey="false" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
