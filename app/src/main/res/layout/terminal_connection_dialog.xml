<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title area: icon + text + search -->
        <LinearLayout
            android:id="@+id/title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/title_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_terminal"
                android:contentDescription="@null"
                android:tint="?attr/colorPrimary"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/terminal_connect_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/search_device_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_search_thin"
                android:contentDescription="@string/terminal_search_devices"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <!-- SearchView (hidden by default, shown when search icon clicked) -->
        <SearchView
            android:id="@+id/device_search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:queryHint="@string/terminal_search_hint"
            android:iconifiedByDefault="false"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Transport type selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminal_transport_label"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/terminal_transport_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/transport_usb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/terminal_transport_usb"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/transport_ble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/terminal_transport_ble"
                android:textSize="14sp" />

        </RadioGroup>

        <!-- Device/Profile selection label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminal_devices_label"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <!-- Long-press hint -->
        <TextView
            android:id="@+id/long_press_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminal_long_press_hint"
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <!-- Device list: all configured devices shown as selectable card rows -->
        <LinearLayout
            android:id="@+id/device_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- Empty state hint -->
        <TextView
            android:id="@+id/device_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminal_no_devices"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Add Profile button (shown when empty) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_profile_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminal_add_profile"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            app:icon="@drawable/ic_add_24" />

    </LinearLayout>

</ScrollView>
