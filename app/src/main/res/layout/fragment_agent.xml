<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/agent_session_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_background"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/agent_session_bar_padding_h"
            android:paddingTop="@dimen/agent_session_bar_padding_v"
            android:paddingEnd="@dimen/agent_session_bar_padding_h"
            android:paddingBottom="@dimen/agent_session_bar_padding_v">

            <TextView
                android:id="@+id/agent_session_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/agent_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/agent_session_hint_size" />

            <TextView
                android:id="@+id/agent_connection_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/agent_connection_pill_bg"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/agent_connection_ready"
                android:textColor="@color/connected"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/agent_demo_picker_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_background"
            android:fillViewport="true"
            android:paddingStart="@dimen/agent_demo_picker_padding_h"
            android:paddingEnd="@dimen/agent_demo_picker_padding_h"
            android:paddingBottom="@dimen/agent_demo_picker_padding_bottom"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/agent_demo_picker_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/agent_messages_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/agent_empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/agent_empty_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/agent_suggested_prompts_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Thinking Row: shown during THINKING state -->
        <LinearLayout
            android:id="@+id/thinking_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                style="?android:attr/progressBarStyleSmall" />

            <TextView
                android:id="@+id/thinking_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Thinking..."
                android:textColor="?android:textColorSecondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_background"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:padding="@dimen/agent_input_bar_padding">

            <EditText
                android:id="@+id/agent_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/agent_input_bg"
                android:hint="@string/agent_input_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingStart="@dimen/agent_input_padding_h"
                android:paddingTop="@dimen/agent_input_padding_v"
                android:paddingEnd="@dimen/agent_input_padding_h"
                android:paddingBottom="@dimen/agent_input_padding_v"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/agent_send_button"
                android:layout_width="@dimen/agent_send_button_size"
                android:layout_height="@dimen/agent_send_button_size"
                android:layout_marginStart="@dimen/agent_send_button_margin_start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/agent_send_cd"
                android:padding="10dp"
                android:src="@drawable/ic_toolbar_send"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/agent_gate_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/agent_gate_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/agent_gate_padding_h"
            android:paddingTop="@dimen/agent_gate_padding_v"
            android:paddingEnd="@dimen/agent_gate_padding_h"
            android:paddingBottom="@dimen/agent_gate_padding_v">

            <ImageView
                android:id="@+id/agent_gate_icon"
                android:layout_width="@dimen/agent_gate_icon_size"
                android:layout_height="@dimen/agent_gate_icon_size"
                android:layout_marginTop="@dimen/agent_gate_icon_margin_top"
                android:contentDescription="@string/top_mode_label_agent"
                android:src="@drawable/agent"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/agent_gate_title_margin_top"
                android:text="@string/agent_gate_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/agent_gate_title_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/agent_gate_subtitle_margin_top"
                android:gravity="center"
                android:text="@string/agent_gate_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/agent_gate_subtitle_size" />

            <LinearLayout
                android:id="@+id/agent_gate_button_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/agent_gate_button_row_margin_top"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agent_gate_byok_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/agent_gate_button_height"
                    android:text="@string/agent_gate_byok" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agent_gate_github_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/agent_gate_button_height"
                    android:layout_marginTop="@dimen/agent_gate_button_gap"
                    android:text="@string/agent_gate_github" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/agent_gate_demo_skip_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/agent_gate_button_height"
                    android:layout_marginTop="@dimen/agent_gate_button_gap_small"
                    android:text="@string/agent_gate_skip_demo" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
