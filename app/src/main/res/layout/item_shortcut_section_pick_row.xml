<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/pick_row_drag_handle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/my_shortcuts_reorder_drag_handle_cd"
        android:focusable="false"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_drag_handle_24"
        android:tint="@color/text_secondary" />

    <include
        android:id="@+id/pick_row_favorite_content"
        layout="@layout/dialog_row_top_strip_favorite_compact"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/pick_row_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/shortcut_hub_cd_edit_shortcut"
        android:focusable="true"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/edit_24"
        android:tint="@color/text_secondary"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/pick_row_bookmark"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_add_to_favorites"
        android:padding="12dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_bookmark_add_24"
        app:tint="@color/text_secondary" />
</LinearLayout>
