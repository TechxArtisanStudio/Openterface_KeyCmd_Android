<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_small"
    android:layout_marginVertical="@dimen/spacing_small"
    android:background="@drawable/bg_presentation_touchpad_dialog"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingEnd="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="@dimen/spacing_small"
            android:text="@string/gamepad_presets_sheet_title"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Title"
            android:textColor="?attr/colorOnSurface"
            tools:text="Layouts" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gamepad_presets_new_layout"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/gamepad_presets_new_layout"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:icon="@drawable/add_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gamepad_presets_reset_shipped_btn"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_tiny"
            android:contentDescription="@string/gamepad_presets_reset_shipped"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:icon="@drawable/change_circle_24px"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:strokeColor="?attr/colorOutline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gamepad_presets_import_btn"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_tiny"
            android:contentDescription="@string/gamepad_presets_import"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:icon="@drawable/folder_open_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:strokeColor="?attr/colorOutline" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gamepad_presets_recycler"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gamepad_presets_recycler_max_height"
        android:layout_marginTop="@dimen/spacing_medium"
        android:clipToPadding="false"
        android:minHeight="48dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:scrollbars="vertical" />
</LinearLayout>
