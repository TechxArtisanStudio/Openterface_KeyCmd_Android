<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/ime_saved_text_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ime_saved_text_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_saved_text_action_preview"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/ime_saved_text_preview_selected_cd"
            android:visibility="gone"
            app:icon="@drawable/ic_visibility_24"
            app:iconTint="?attr/colorControlNormal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_saved_text_action_load"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/ime_saved_text_load_selected_cd"
            android:visibility="gone"
            app:icon="@drawable/ic_file_download_material_24"
            app:iconTint="?attr/colorControlNormal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_saved_text_action_send"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/ime_saved_text_send_selected_cd"
            android:visibility="gone"
            app:icon="@drawable/ic_send_material_24"
            app:iconTint="?attr/colorControlNormal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_saved_text_save_current"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/ime_saved_text_save_cd"
            app:icon="@drawable/ic_top_save"
            app:iconTint="?attr/colorControlNormal" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ime_saved_text_list"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/ime_saved_text_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp"
        android:text="@string/ime_saved_text_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />
</LinearLayout>
