<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/background_light">

    <TextView
        android:id="@+id/basic_compose_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/kb_basic_back_to_keyboard"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kb_basic_compose_hint"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/basic_compose_editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="6"
        android:background="@android:drawable/edit_text" />

    <Button
        android:id="@+id/basic_compose_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/kb_basic_compose_send" />
</LinearLayout>
