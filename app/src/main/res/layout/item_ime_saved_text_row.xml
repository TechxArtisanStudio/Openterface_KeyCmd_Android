<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/ime_saved_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/ime_saved_row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/ime_saved_row_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ime_saved_text_preview_cd"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ime_saved_row_pin"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/ime_saved_text_pin"
        app:icon="@drawable/ic_bookmark_star_24"
        app:iconSize="22dp"
        app:iconTint="?attr/colorControlNormal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ime_saved_row_load"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/ime_saved_text_load"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ime_saved_row_send"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/ime_saved_text_send"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ime_saved_row_more"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/ime_saved_text_more"
        app:icon="@drawable/ic_more_vert_24"
        app:iconTint="?attr/colorControlNormal" />
</LinearLayout>
