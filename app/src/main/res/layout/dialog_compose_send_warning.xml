<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/compose_send_warning_simple_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/compose_send_warning_tabbed_dialog_gutter_h"
    android:paddingTop="@dimen/compose_send_warning_tabbed_dialog_gutter_top"
    android:paddingEnd="@dimen/compose_send_warning_tabbed_dialog_gutter_h"
    android:paddingBottom="@dimen/compose_send_warning_tabbed_dialog_gutter_bottom">

    <LinearLayout
        android:id="@+id/compose_send_warning_simple_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/compose_send_warning_dialog_body_padding_h"
        android:paddingTop="@dimen/compose_send_warning_dialog_body_padding_top"
        android:paddingEnd="@dimen/compose_send_warning_dialog_body_padding_h"
        android:paddingBottom="@dimen/compose_send_warning_dialog_body_padding_bottom">

        <TextView
            android:id="@+id/compose_send_warning_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compose_send_warning_send_anyway_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/compose_send_warning_send_anyway"
            app:icon="@drawable/ic_send_warning_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="22dp"
            app:iconTint="?attr/colorOnPrimary" />

        <LinearLayout
            android:id="@+id/compose_send_warning_inline_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compose_send_warning_check_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/compose_send_warning_check"
                android:minHeight="44dp"
                android:text="@string/compose_send_warning_check"
                app:icon="@drawable/chat_error_24px"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compose_send_warning_preview_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/compose_send_warning_preview"
                android:minHeight="44dp"
                android:text="@string/compose_send_warning_preview"
                app:icon="@drawable/search_check_2_24px"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compose_send_warning_unicode_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compose_send_warning_unicode_host_entry_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/compose_send_warning_send_unicode_short"
                app:icon="@drawable/ic_code_xml_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="?attr/colorOnSecondaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compose_send_warning_unicode_info_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/compose_send_warning_unicode_info_cd"
                app:icon="@drawable/ic_touchpad_info_24"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
