<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded sheet wraps scroll + pinned footer so Remove/Reset/Done stay visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gamepad_module_config_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_presentation_touchpad_dialog"
    android:padding="@dimen/spacing_medium"
    android:layout_marginHorizontal="@dimen/spacing_small"
    android:layout_marginVertical="@dimen/spacing_small"
    android:clipToOutline="true">

<com.openterface.keymod.widget.MaxHeightNestedScrollView
    android:id="@+id/gamepad_module_config_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="vertical"
    android:fadeScrollbars="true"
    android:overScrollMode="ifContentScrolls"
    android:clipToPadding="false"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/gamepad_module_config_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_small">

        <TextView
            android:id="@+id/stick_config_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_stick_config_title"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.SheetTitle"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/stick_config_dpad_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_stick_config_dpad_hint"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Mode Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_stick_config_section_mode"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/stick_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/stick_mode_analog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_mode_analog"
                android:textColor="?attr/colorOnSurface"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/stick_mode_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_mode_key"
                android:textColor="?attr/colorOnSurface"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/stick_mode_dpad_cross"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_mode_dpad_cross"
                android:textColor="?attr/colorOnSurface"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/stick_mode_dpad_split"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_mode_dpad_split"
                android:textColor="?attr/colorOnSurface"
                android:buttonTint="?attr/colorPrimary" />
        </RadioGroup>

        <!-- Right stick: pointer (mouse-direction) sensitivity when type is STICK_MOUSE -->
        <LinearLayout
            android:id="@+id/stick_pointer_mouse_sensitivity_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_pointer_mouse_sensitivity_title"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_pointer_mouse_sensitivity_summary"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_config_slider_slower"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/stick_pointer_mouse_sensitivity_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="150"
                    android:progress="50"
                    android:progressTint="?attr/colorPrimary"
                    android:thumbTint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_config_slider_faster"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dpad_split_gap_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_dpad_split_gap_title"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_dpad_split_gap_summary"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_dpad_split_gap_tight"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/dpad_split_gap_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="?attr/colorPrimary"
                    android:thumbTint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_dpad_split_gap_wide"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dpad_split_outer_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_dpad_split_outer_title"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_dpad_split_outer_summary"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_dpad_split_outer_near"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/dpad_split_outer_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="?attr/colorPrimary"
                    android:thumbTint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_dpad_split_outer_far"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- D-Pad Key Mapping Section -->
        <LinearLayout
            android:id="@+id/key_mapping_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_direction_keys_label"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="12dp" />

            <!-- D-Pad Cross Layout -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <!-- Row 1: empty, up, empty -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/key_up"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp" />
                </LinearLayout>

                <!-- Row 2: left, center, right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/key_left"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background" />

                    <Button
                        android:id="@+id/key_right"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Row 3: empty, down, empty -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/key_down"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stick_center_key_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_stick_center_key_title"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/stick_center_key_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_stick_center_key_summary"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/stick_pointer_hub_mouse_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gamepad_stick_pointer_hub_mouse_title"
                        android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                        android:layout_marginBottom="4dp" />

                    <RadioGroup
                        android:id="@+id/stick_pointer_hub_mouse_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/stick_pointer_hub_mouse_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/gamepad_stick_pointer_hub_mouse_left" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/stick_pointer_hub_mouse_middle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/gamepad_stick_pointer_hub_mouse_middle" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/stick_pointer_hub_mouse_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/gamepad_stick_pointer_hub_mouse_right" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/stick_center_key_btn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/stick_center_key_clear_btn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gamepad_stick_center_key_clear"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <include layout="@layout/include_gamepad_module_color_section" />

        <!-- Stick Size Slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_stick_config_size_label"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_config_slider_small"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginEnd="8dp" />

            <SeekBar
                android:id="@+id/stick_size_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"
                android:progressTint="?attr/colorPrimary"
                android:thumbTint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_config_slider_large"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</com.openterface.keymod.widget.MaxHeightNestedScrollView>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small" />

    <!-- Pinned footer: always visible below scroll -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/spacing_small">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stick_remove_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_menu_remove"
            android:textAllCaps="false"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/spacing_small"
            app:strokeColor="?attr/colorError"
            app:strokeWidth="1dp"
            android:textColor="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stick_reset_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_config_reset"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/spacing_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stick_done_btn"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_config_done"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
