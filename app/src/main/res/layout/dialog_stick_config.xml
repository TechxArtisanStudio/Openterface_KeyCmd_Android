<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/background_light"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/stick_config_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_stick_config_title"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Title"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/stick_config_dpad_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_stick_config_dpad_hint"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Mode Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_stick_config_section_mode"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/stick_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/stick_mode_analog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_mode_analog"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/stick_mode_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_mode_key"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/stick_mode_dpad_cross"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_mode_dpad_cross"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/stick_mode_dpad_split"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_mode_dpad_split"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/primary" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/dpad_split_gap_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_dpad_split_gap_title"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_dpad_split_gap_summary"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_dpad_split_gap_tight"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/dpad_split_gap_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/primary"
                    android:thumbTint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_dpad_split_gap_wide"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dpad_split_outer_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_dpad_split_outer_title"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_dpad_split_outer_summary"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_dpad_split_outer_near"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/dpad_split_outer_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/primary"
                    android:thumbTint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_dpad_split_outer_far"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- D-Pad Key Mapping Section -->
        <LinearLayout
            android:id="@+id/key_mapping_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_stick_direction_keys_label"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="12dp" />

            <!-- D-Pad Cross Layout -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <!-- Row 1: empty, up, empty -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/key_up"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp" />
                </LinearLayout>

                <!-- Row 2: left, center, right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/key_left"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background" />

                    <Button
                        android:id="@+id/key_right"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Row 3: empty, down, empty -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp" />

                    <Button
                        android:id="@+id/key_down"
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/function_button_background"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Stick Size Slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_stick_config_size_label"
            android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_config_slider_small"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginEnd="8dp" />

            <SeekBar
                android:id="@+id/stick_size_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_config_slider_large"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stick_reset_btn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_config_reset"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stick_done_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_config_done"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/primary"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
