<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/module_color_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gamepad_module_color_section_title"
        android:textAppearance="@style/TextAppearance.KeyCmd.GamepadConfig.Section"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/module_color_theme_default"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gamepad_module_color_theme_default"
        android:textAllCaps="false"
        android:layout_marginBottom="10dp" />

    <com.openterface.keymod.widget.NestedFriendlyHorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fadeScrollbars="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_tiny"
        android:paddingEnd="@dimen/spacing_tiny"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/module_color_swatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:paddingStart="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_medium" />
    </com.openterface.keymod.widget.NestedFriendlyHorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/module_color_custom"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gamepad_module_color_custom"
        android:textAllCaps="false"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp" />

</LinearLayout>
