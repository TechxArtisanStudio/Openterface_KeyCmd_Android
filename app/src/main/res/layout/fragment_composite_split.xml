<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/split_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Shared top scrolling panel: slightly reduced to free more height for touchpad area -->
    <FrameLayout
        android:id="@+id/split_top_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"/>

    <!-- Main content: stacked keyboards and touchpad for portrait -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="22"
        android:orientation="vertical">

        <!-- Left Keyboard -->
        <com.openterface.keymod.CustomKeyboardView
            android:id="@+id/keyboard_view_left"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.9"
            android:paddingTop="@dimen/keyboard_outer_padding_top"
            android:paddingBottom="@dimen/keyboard_outer_padding_bottom"
            android:keyBackground="@drawable/key_background"
            android:theme="@style/ButtonTheme"
            app:showGuiHidKey="false"/>

        <!-- Touchpad Section (center): pad + optional mouse keys -->
        <LinearLayout
            android:id="@+id/touchpad_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.15"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/pro_touchpad_chrome_root"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/touchpad_pad_host"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <FrameLayout
                        android:id="@+id/touchpad_pad_content"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/touchpad_background">

                    <com.openterface.keymod.TouchPadView
                        android:id="@+id/touchPad"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <LinearLayout
                        android:id="@+id/touchPadFooter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:background="@android:color/transparent">

                        <TextView
                            android:id="@+id/touchPadTips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:paddingTop="6dp"
                            android:paddingBottom="4dp"
                            android:background="@android:color/transparent"
                            android:text="@string/touch_pad_compact_initial"/>

                        <ImageView
                            android:id="@+id/touchPadBrandLogo"
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:layout_marginTop="2dp"
                            android:maxWidth="200dp"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:alpha="0.82"
                            android:src="@drawable/ic_openterface_wordmark"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@string/touch_pad_brand_content_description"
                            android:importantForAccessibility="yes"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/touchPadHelpOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:translationY="@dimen/touchpad_help_overlay_shift_up"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:maxWidth="@dimen/touchpad_help_overlay_max_width_split"
                        android:visibility="gone"
                        android:alpha="0"
                        android:gravity="center_horizontal"
                        android:padding="8dp"
                        android:background="@android:color/transparent"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:letterSpacing="0.01"
                        android:lineSpacingMultiplier="1.22"
                        android:scrollbars="none" />

                    <ImageButton
                        android:id="@+id/touchPadInfo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/touch_pad_info_content_description"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_touchpad_info_24" />

                    </FrameLayout>

                    <com.openterface.keymod.basic.BasicPortraitScrollStripView
                        android:id="@+id/pro_touchpad_scroll_strip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:minWidth="@dimen/pro_touchpad_scroll_strip_min_width"
                        android:visibility="gone"
                        android:background="@color/touchpad_background"
                        android:contentDescription="@string/km_pro_touchpad_scroll_strip_a11y" />
                </LinearLayout>

                <include layout="@layout/include_pro_touchpad_mouse_keys" />

            </LinearLayout>

        </LinearLayout>

        <!-- Right Keyboard -->
        <com.openterface.keymod.CustomKeyboardView
            android:id="@+id/keyboard_view_right"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.9"
            android:paddingTop="@dimen/keyboard_outer_padding_top"
            android:paddingBottom="@dimen/keyboard_outer_padding_bottom"
            android:keyBackground="@drawable/key_background"
            android:theme="@style/ButtonTheme"
            app:showGuiHidKey="false"/>

    </LinearLayout>

</LinearLayout>
