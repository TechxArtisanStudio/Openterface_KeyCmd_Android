<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded sheet wraps scroll + pinned footer so Remove/Reset/Done stay visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gamepad_module_config_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:orientation="vertical"
    android:background="@drawable/bg_presentation_touchpad_dialog"
    android:padding="@dimen/spacing_medium"
    android:layout_marginHorizontal="@dimen/spacing_small"
    android:layout_marginVertical="@dimen/spacing_small"
    android:clipToOutline="true">

<com.openterface.keymod.widget.MaxHeightNestedScrollView
    android:id="@+id/gamepad_module_config_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="vertical"
    android:fadeScrollbars="true"
    android:overScrollMode="ifContentScrolls"
    android:clipToPadding="false"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/gamepad_module_config_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_small">

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_button_config_title_placeholder"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.SheetTitle"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/button_cap_label_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:hint="@string/gamepad_button_cap_label_hint"
                app:counterEnabled="true"
                app:counterMaxLength="6">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/button_cap_label_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/include_gamepad_module_color_section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_button_config_mapped_key"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/button_show_mapped_key_label_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_button_config_show_mapped_key_label"
                android:contentDescription="@string/gamepad_button_config_show_mapped_key_label_cd"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_key_label"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:textAllCaps="false"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_button_config_size"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_config_slider_small"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/button_size_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100"
                    android:progressTint="?attr/colorPrimary"
                    android:thumbTint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_config_slider_large"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_button_corner_title"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Section"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_button_corner_summary"
                android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_button_corner_square"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/button_corner_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="?attr/colorPrimary"
                    android:thumbTint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gamepad_button_corner_round"
                    android:textAppearance="@style/TextAppearance.KeyMod.GamepadConfig.Caption"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

    </LinearLayout>
</com.openterface.keymod.widget.MaxHeightNestedScrollView>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/spacing_small">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remove"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_menu_remove"
            android:textAllCaps="false"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/spacing_small"
            app:strokeColor="?attr/colorError"
            app:strokeWidth="1dp"
            android:textColor="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_config_reset"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/spacing_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamepad_config_done"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
