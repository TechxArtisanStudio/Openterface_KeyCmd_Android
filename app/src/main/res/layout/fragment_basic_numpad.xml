<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/basic_numpad_back_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/kb_basic_back_to_keyboard"
        android:textColor="?attr/colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 5 columns × 6 rows; + and Enter span two rows; bottom 0 spans two columns -->
    <GridLayout
        android:id="@+id/basic_numpad_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:alignmentMode="alignMargins"
        android:columnCount="5"
        android:rowCount="6"
        android:useDefaultMargins="false">

        <!-- Row 0 -->
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/kb_basic_numpad_prt_sc"
            android:tag="PrtSc" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/kb_basic_numpad_scr_lk"
            android:tag="ScrLk" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_pause"
            android:tag="Pause" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_home"
            android:tag="Home" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="4"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_end"
            android:tag="End" />

        <!-- Row 1 -->
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_pg_up"
            android:tag="PgUp" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_num_lock"
            android:tag="NUM_LOCK" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="/"
            android:tag="NUMPAD_DIVIDE" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="*"
            android:tag="NUMPAD_MULTIPLY" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="4"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="-"
            android:tag="NUMPAD_SUBTRACT" />

        <!-- Row 2 -->
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_pg_dn"
            android:tag="PgDn" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="7"
            android:tag="NUMPAD_7" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="8"
            android:tag="NUMPAD_8" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="9"
            android:tag="NUMPAD_9" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_column="4"
            android:layout_rowSpan="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="+"
            android:tag="NUMPAD_ADD"
            android:contentDescription="@string/kb_basic_numpad_plus_desc" />

        <!-- Row 3 -->
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_ins"
            android:tag="Ins" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="4"
            android:tag="NUMPAD_4" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="5"
            android:tag="NUMPAD_5" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="6"
            android:tag="NUMPAD_6" />

        <!-- Row 4 -->
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_del"
            android:tag="Delete" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="4"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="1"
            android:tag="NUMPAD_1" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="4"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="2"
            android:tag="NUMPAD_2" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="4"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="3"
            android:tag="NUMPAD_3" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="4"
            android:layout_column="4"
            android:layout_rowSpan="2"
            android:layout_columnWeight="1"
            android:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_enter"
            android:tag="NUMPAD_ENTER"
            android:contentDescription="@string/kb_basic_numpad_enter_desc" />

        <!-- Row 5 -->
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="5"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_00"
            android:tag="NUMPAD_00" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="5"
            android:layout_column="1"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="0"
            android:tag="NUMPAD_0"
            android:contentDescription="@string/kb_basic_numpad_zero_desc" />
        <TextView
            style="@style/Widget.KeyMod.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="5"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="."
            android:tag="NUMPAD_DOT" />
    </GridLayout>
</LinearLayout>
