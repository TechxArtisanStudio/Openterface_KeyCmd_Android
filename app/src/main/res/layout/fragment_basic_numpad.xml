<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/basic_numpad_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/basic_keyboard_content_inset"
    android:paddingEnd="@dimen/basic_keyboard_content_inset_end"
    android:paddingTop="8dp"
    android:paddingBottom="@dimen/basic_keyboard_content_inset_bottom"
    android:background="@color/background_light">

    <!-- 5 columns × 8 rows; row height ratio 1:1:2:2:3:3:3:3 (weights per row). ESC spans rows 0–1 (weight 1+1); + spans 4–5 (3+3); Enter spans 6–7 (3+3). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/basic_numpad_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alignmentMode="alignMargins"
        app:columnCount="5"
        app:rowCount="8"
        android:useDefaultMargins="false">

        <!-- Rows 0–1: ESC (full height of two rows); TAB + ScrLk in col 1; nav cluster (half-height per row) -->
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="0"
            app:layout_column="0"
            app:layout_rowSpan="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/kb_basic_numpad_esc"
            android:tag="Esc" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="0"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/kb_basic_numpad_tab"
            android:tag="TAB" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="1"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/kb_basic_numpad_scr_lk"
            android:tag="ScrLk" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="0"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/kb_basic_numpad_nav_del"
            android:tag="Delete" />
        <androidx.appcompat.widget.AppCompatImageView
            style="@style/KeyCmdBasicNumpadIconCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="0"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:contentDescription="@string/kb_basic_numpad_nav_up"
            android:tag="DPAD_UP"
            app:srcCompat="@drawable/keyboard_arrow_up_24"
            app:tint="@color/text_primary" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="0"
            app:layout_column="4"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/kb_basic_numpad_nav_bksp"
            android:tag="DEL" />
        <androidx.appcompat.widget.AppCompatImageView
            style="@style/KeyCmdBasicNumpadIconCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="1"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:contentDescription="@string/kb_basic_numpad_nav_left"
            android:tag="DPAD_LEFT"
            app:srcCompat="@drawable/keyboard_arrow_left_24"
            app:tint="@color/text_primary" />
        <androidx.appcompat.widget.AppCompatImageView
            style="@style/KeyCmdBasicNumpadIconCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="1"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:contentDescription="@string/kb_basic_numpad_nav_down"
            android:tag="DPAD_DOWN"
            app:srcCompat="@drawable/keyboard_arrow_down_24"
            app:tint="@color/text_primary" />
        <androidx.appcompat.widget.AppCompatImageView
            style="@style/KeyCmdBasicNumpadIconCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="1"
            app:layout_column="4"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:contentDescription="@string/kb_basic_numpad_nav_right"
            android:tag="DPAD_RIGHT"
            app:srcCompat="@drawable/keyboard_arrow_right_24"
            app:tint="@color/text_primary" />

        <!-- Row 2: Prt Sc Pause Home End = (height weight 2) -->
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="2"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/kb_basic_numpad_prt_sc"
            android:tag="PrtSc" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="2"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_pause"
            android:tag="Pause" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="2"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_home"
            android:tag="Home" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="2"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_end"
            android:tag="End" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="2"
            app:layout_column="4"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="="
            android:tag="NUMPAD_EQUALS" />

        <!-- Row 3 -->
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="3"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_pg_up"
            android:tag="PgUp" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="3"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_num_lock"
            android:tag="NUM_LOCK" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="3"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="/"
            android:tag="NUMPAD_DIVIDE" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="3"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="*"
            android:tag="NUMPAD_MULTIPLY" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="3"
            app:layout_column="4"
            app:layout_columnWeight="1"
            app:layout_rowWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="-"
            android:tag="NUMPAD_SUBTRACT" />

        <!-- Rows 4–5: + spans two rows (row weights 3+3) -->
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="4"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_pg_dn"
            android:tag="PgDn" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="4"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="7"
            android:tag="NUMPAD_7" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="4"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="8"
            android:tag="NUMPAD_8" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="4"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="9"
            android:tag="NUMPAD_9" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="4"
            app:layout_column="4"
            app:layout_rowSpan="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="6"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="+"
            android:tag="NUMPAD_ADD"
            android:contentDescription="@string/kb_basic_numpad_plus_desc" />

        <!-- Row 5 -->
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="5"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_ins"
            android:tag="Ins" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="5"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="4"
            android:tag="NUMPAD_4" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="5"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="5"
            android:tag="NUMPAD_5" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="5"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="6"
            android:tag="NUMPAD_6" />

        <!-- Rows 6–7: Enter spans two rows (row weights 3+3) -->
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="6"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_nav_bksp"
            android:tag="DEL" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="6"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="1"
            android:tag="NUMPAD_1" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="6"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="2"
            android:tag="NUMPAD_2" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="6"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="3"
            android:tag="NUMPAD_3" />
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="6"
            app:layout_column="4"
            app:layout_rowSpan="2"
            app:layout_columnWeight="1"
            app:layout_rowWeight="6"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_enter"
            android:tag="NUMPAD_ENTER"
            android:contentDescription="@string/kb_basic_numpad_enter_desc" />

        <!-- Row 7 -->
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="7"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="@string/kb_basic_numpad_00"
            android:tag="NUMPAD_00" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="7"
            app:layout_column="1"
            app:layout_columnSpan="2"
            app:layout_columnWeight="2"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:background="@drawable/km_basic_numpad_key_background"
            android:layout_margin="4dp"
            android:tag="NUMPAD_0">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:duplicateParentState="true"
                android:adjustViewBounds="true"
                android:maxWidth="@dimen/km_basic_numpad_zero_wordmark_max_width"
                android:maxHeight="@dimen/km_basic_numpad_zero_wordmark_max_height"
                android:contentDescription="@string/kb_basic_numpad_zero_desc"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_openterface_wordmark"
                app:tint="@color/basic_key_label_color" />
        </FrameLayout>
        <TextView
            style="@style/Widget.KeyCmd.BasicNumpadCell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_row="7"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_rowWeight="3"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="."
            android:tag="NUMPAD_DOT" />
    </androidx.gridlayout.widget.GridLayout>

    </FrameLayout>
</LinearLayout>
