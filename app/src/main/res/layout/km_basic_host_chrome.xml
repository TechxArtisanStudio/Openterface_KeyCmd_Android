<?xml version="1.0" encoding="utf-8"?>
<!-- KM Basic shared chrome: menu, submode tabs, target OS, connection. Lives in KeyboardMouseFragment host. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/km_basic_chrome_row_height"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:background="@color/header_background"
    android:elevation="@dimen/header_elevation"
    android:padding="@dimen/header_padding">

    <ImageButton
        android:id="@+id/basic_km_menu_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu"
        android:tint="@color/text_primary" />

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/basic_km_tab_keyboard"
                style="@style/KbMouseSubmodeTab"
                android:text="@string/kb_mouse_sub_keyboard" />

            <TextView
                android:id="@+id/basic_km_tab_touchpad"
                style="@style/KbMouseSubmodeTab"
                android:text="@string/kb_mouse_sub_touchpad" />

            <TextView
                android:id="@+id/basic_km_tab_ime"
                style="@style/KbMouseSubmodeTab"
                android:text="@string/kb_mouse_sub_ime" />

            <TextView
                android:id="@+id/basic_km_tab_numpad"
                style="@style/KbMouseSubmodeTab"
                android:text="@string/kb_mouse_sub_numpad" />
        </LinearLayout>
    </HorizontalScrollView>

    <ImageButton
        android:id="@+id/basic_km_target_os"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/target_os_header_cd"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_os_macos"
        android:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/basic_km_setup_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/km_basic_setup_button_cd"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        android:tint="@color/text_secondary" />

    <LinearLayout
        android:id="@+id/basic_km_connection"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/basic_km_connection_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/connection"
            android:src="@drawable/ic_bluetooth"
            android:tint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
