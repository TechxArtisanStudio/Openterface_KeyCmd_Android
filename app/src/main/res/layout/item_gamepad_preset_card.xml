<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/preset_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_tiny"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/gamepad_preset_card_preview_height">

            <ImageView
                android:id="@+id/preset_card_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurfaceVariant"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                tools:ignore="ContentDescription" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/preset_card_drag_handle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/gamepad_preset_row_drag_handle_cd"
                android:focusable="false"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_drag_handle_24"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Single row: built-in icon (when shipped) | title | overflow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_tiny"
            android:paddingBottom="@dimen/spacing_small">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/preset_card_builtin_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/spacing_tiny"
                android:contentDescription="@string/gamepad_presets_builtin_badge"
                android:importantForAccessibility="yes"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_gamepad_preset_builtin_20"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/preset_card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Minecraft Java" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset_card_more"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/gamepad_preset_row_menu_cd"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="40dp"
                android:minHeight="40dp"
                app:icon="@drawable/three_dots"
                app:iconSize="24dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
