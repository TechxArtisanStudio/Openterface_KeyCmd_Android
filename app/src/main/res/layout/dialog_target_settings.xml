<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bottom_sheet_background"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingEnd="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_large">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:text="@string/target_settings_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/text_primary" />

    <!-- ══════════════════════════════════════════ -->
    <!-- Section 1: Target OS                        -->
    <!-- ═══════════════════════════════════════════ -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/target_settings_section_os"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small">

            <ImageButton
                android:id="@+id/os_button_macos"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/target_os_macos"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_os_macos"
                android:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/os_button_windows"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/target_os_windows"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_os_windows"
                android:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/os_button_linux"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/target_os_linux"
                android:padding="@dimen/spacing_small"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_os_linux"
                android:tint="@color/text_primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="@color/divider" />

    <!-- ══════════════════════════════════════════ -->
    <!-- Section 2: Terminal Profile                  -->
    <!-- ═══════════════════════════════════════════ -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_small"
        android:text="@string/target_settings_section_profile"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profile_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <TextView
        android:id="@+id/profile_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/target_settings_no_profile"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:padding="@dimen/spacing_large"
        android:visibility="gone" />

</LinearLayout>
