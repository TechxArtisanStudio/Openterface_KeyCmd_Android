<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Gamepad View -->
    <com.openterface.keymod.GamepadView
        android:id="@+id/gamepad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Control toggles row (center top) -->
    <LinearLayout
        android:id="@+id/toggle_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/gamepad_toolbar_margin_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/gamepad_toolbar_padding_h">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_mode_toggle"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/gamepad_toolbar_button_min_height"
            android:minWidth="@dimen/gamepad_toolbar_edit_min_width"
            android:checkable="true"
            android:checked="false"
            android:text="@string/gamepad_edit_mode_off"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="@dimen/gamepad_toolbar_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gamepad_presets_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/gamepad_toolbar_button_min_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:minWidth="@dimen/gamepad_toolbar_preset_min_width"
            android:text="@string/gamepad_presets_button"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="@dimen/gamepad_toolbar_corner_radius" />

        <TextView
            android:id="@+id/gamepad_active_preset_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:maxWidth="@dimen/gamepad_preset_name_max_width"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- Done button for edit mode (hidden by default) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/edit_done_btn"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="@string/gamepad_edit_done"
        android:textAllCaps="false"
        android:visibility="gone"
        app:cornerRadius="@dimen/gamepad_toolbar_corner_radius" />

</FrameLayout>
