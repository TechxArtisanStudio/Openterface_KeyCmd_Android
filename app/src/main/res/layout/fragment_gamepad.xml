<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Gamepad View -->
    <com.openterface.keymod.GamepadView
        android:id="@+id/gamepad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Menu + connection (top); top margin applied in code with status bar insets -->
    <LinearLayout
        android:id="@+id/gamepad_chrome_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/gamepad_chrome_menu"
            android:layout_width="@dimen/header_icon_size"
            android:layout_height="@dimen/header_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:padding="@dimen/button_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            android:tint="@color/text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/gamepad_chrome_connection_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/gamepad_chrome_connection_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/connection"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Slim bar while repositioning modules (move mode) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/gamepad_edit_session_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="@dimen/spacing_small"
        android:layout_marginTop="0dp"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/gamepad_toolbar_corner_radius"
        app:cardElevation="4dp"
        app:contentPadding="@dimen/spacing_small"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gamepad_edit_session_done"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamepad_edit_done"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:text="@string/gamepad_edit_session_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Control toggles row (center top) -->
    <LinearLayout
        android:id="@+id/toggle_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gamepad_toolbar_padding_h">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_mode_toggle"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="@dimen/gamepad_toolbar_button_min_height"
            android:layout_height="@dimen/gamepad_toolbar_button_min_height"
            android:checkable="true"
            android:checked="false"
            android:contentDescription="@string/gamepad_customize_cd"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:cornerRadius="@dimen/gamepad_toolbar_corner_radius"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/gamepad_edit_toggle_icon_tint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gamepad_active_preset_chip"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/gamepad_toolbar_button_min_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:ellipsize="end"
            android:maxWidth="@dimen/gamepad_preset_chip_max_width"
            android:maxLines="1"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="@dimen/gamepad_toolbar_corner_radius"
            app:icon="@drawable/ic_expand_more_24"
            app:iconGravity="end"
            app:iconPadding="4dp"
            app:iconSize="18dp"
            app:iconTint="?android:attr/textColorSecondary"
            tools:text="Default" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gamepad_presets_btn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="@dimen/gamepad_toolbar_button_min_height"
            android:layout_height="@dimen/gamepad_toolbar_button_min_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:contentDescription="@string/gamepad_cycle_next_preset_cd"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:cornerRadius="@dimen/gamepad_toolbar_corner_radius"
            app:icon="@drawable/ic_swap_horiz_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gamepad_mapping_hints_toggle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="@dimen/gamepad_toolbar_button_min_height"
            android:layout_height="@dimen/gamepad_toolbar_button_min_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:checkable="true"
            android:contentDescription="@string/gamepad_mapping_hints_toggle_cd"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:cornerRadius="@dimen/gamepad_toolbar_corner_radius"
            app:icon="@drawable/ic_visibility_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?android:attr/textColorSecondary" />
    </LinearLayout>

</FrameLayout>
