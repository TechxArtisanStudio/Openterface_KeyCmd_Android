    <style name="ButtonTheme" parent="Theme.AppCompat.Light">
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Inherits accent from the active KeyCmd theme (no fixed orange). -->
    <style name="Theme.KeyCmd.Presentation" parent="Base.Theme.KeyCmd" />

    <!-- Full-screen “reading mode” help above the reorder bottom sheet (blur/dim behind on API 31+). -->
    <style name="Theme.KeyCmd.FullScreenReadingHelp" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Gamepad mode only: dark surfaces / Material widgets regardless of app DayNight. -->
    <style name="ThemeOverlay.KeyCmd.Gamepad" parent="ThemeOverlay.Material3.Dark" />

    <!-- Layouts sheet: presentation_card is a light (or night) surface; gamepad overlay uses Dark
         tokens so colorOnSurface was light-on-white. (Legacy overlay kept for reference.) -->
    <style name="ThemeOverlay.KeyCmd.GamepadPresetSheet" parent="ThemeOverlay.Material3.Dark">
        <item name="android:colorBackground">@color/presentation_card_bg</item>
        <item name="colorSurface">@color/presentation_card_bg</item>
        <item name="colorOnSurface">@color/presentation_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/presentation_text_secondary</item>
        <item name="colorOutline">@color/text_secondary</item>
        <item name="colorOutlineVariant">@color/divider</item>
    </style>

    <!-- Layouts picker: floating dialog (no BottomSheet CoordinatorLayout) so the preset list scrolls reliably. -->
    <style name="Theme.KeyCmd.GamepadPresetPickerDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <!-- Let our explicit window width win; avoid AppCompat-style min-width forcing near full-bleed on some devices. -->
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:colorBackground">@color/presentation_card_bg</item>
        <item name="colorSurface">@color/presentation_card_bg</item>
        <item name="colorOnSurface">@color/presentation_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/presentation_text_secondary</item>
        <item name="colorOutline">@color/text_secondary</item>
        <item name="colorOutlineVariant">@color/divider</item>
    </style>
