<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spacing -->
    <dimen name="spacing_tiny">4dp</dimen>
    <dimen name="spacing_small">8dp</dimen>
    <dimen name="spacing_medium">16dp</dimen>
    <dimen name="spacing_large">24dp</dimen>
    <dimen name="spacing_xlarge">32dp</dimen>
    
    <!-- Header -->
    <dimen name="header_height">56dp</dimen>
    <dimen name="header_padding">8dp</dimen>
    <dimen name="header_elevation">4dp</dimen>
    <dimen name="header_icon_size">40dp</dimen>
    <dimen name="header_title_size">18sp</dimen>
    
    <!-- Buttons -->
    <dimen name="button_icon_padding">12dp</dimen>
    <dimen name="button_corner_radius">8dp</dimen>
    <dimen name="button_elevation">2dp</dimen>
    
    <!-- Sidebar -->
    <dimen name="sidebar_width">280dp</dimen>
    <dimen name="sidebar_padding">16dp</dimen>
    <dimen name="sidebar_item_padding">16dp</dimen>
    <dimen name="sidebar_item_margin">8dp</dimen>
    <dimen name="sidebar_item_radius">12dp</dimen>
    <dimen name="sidebar_title_size">18sp</dimen>
    <dimen name="sidebar_item_text_size">16sp</dimen>
    
    <!-- Fragment -->
    <dimen name="fragment_padding">8dp</dimen>
    <dimen name="fragment_margin">8dp</dimen>

    <!-- KM Basic embedded chrome row: same fixed height as Pro `header_layout` (portrait/landscape follow @dimen/header_height). -->
    <dimen name="km_basic_chrome_row_height">@dimen/header_height</dimen>
    <!-- KM Basic: keep tab chrome clear of status bar / cutout (used with WindowInsets; floor when insets are 0). -->
    <dimen name="km_basic_chrome_min_top_padding">12dp</dimen>
    <!-- KM Basic compose: min editor height in portrait (NestedScrollView allows shrinking when IME shows). -->
    <dimen name="basic_compose_editor_min_height">120dp</dimen>

    <!-- Gamepad toolbar -->
    <!-- Full-width fade behind chrome + centered toggle (same vertical band); not a solid bar. -->
    <!-- Taller band so the top fade reads softer over more of the canvas. -->
    <dimen name="gamepad_toolbar_scrim_height">160dp</dimen>
    <!-- When edit row is hidden (play mode), still a bit taller than chrome for a gentle falloff. -->
    <dimen name="gamepad_toolbar_scrim_height_play">108dp</dimen>
    <dimen name="gamepad_toolbar_margin_top">8dp</dimen>
    <dimen name="gamepad_toolbar_padding_h">4dp</dimen>
    <dimen name="gamepad_toolbar_button_min_height">40dp</dimen>
    <dimen name="gamepad_toolbar_corner_radius">12dp</dimen>
    <dimen name="gamepad_toolbar_edit_min_width">72dp</dimen>
    <dimen name="gamepad_toolbar_preset_min_width">76dp</dimen>
    <dimen name="gamepad_preset_name_max_width">140dp</dimen>
    <dimen name="gamepad_preset_chip_max_width">220dp</dimen>
    <dimen name="gamepad_creator_chip_max_width">100dp</dimen>
    <!-- Layouts bottom sheet (portrait + GamepadFragment). -->
    <dimen name="gamepad_presets_recycler_max_height">320dp</dimen>
    <dimen name="gamepad_presets_recycler_max_height_land">360dp</dimen>
    <dimen name="gamepad_presets_bottom_sheet_max_width">360dp</dimen>
    <dimen name="gamepad_presets_bottom_sheet_min_width">252dp</dimen>
    <!-- Layouts grid dialog (landscape-first card picker). -->
    <dimen name="gamepad_preset_card_preview_height">96dp</dimen>
    <!-- Vertical breathing room around full keyboard blocks -->
    <dimen name="keyboard_outer_padding_top">6dp</dimen>
    <dimen name="keyboard_outer_padding_bottom">8dp</dimen>
    <!-- KM Basic physical keyboard: horizontal inset so edge keys are easier to tap -->
    <dimen name="basic_keyboard_content_inset">18dp</dimen>
    <!-- End (LTR: right); defaults same as start; landscape can override for a slimmer nav margin. -->
    <dimen name="basic_keyboard_content_inset_end">18dp</dimen>
    <!-- Bottom (portrait: below Space row); separate so it can be tighter than start/end. -->
    <dimen name="basic_keyboard_content_inset_bottom">12dp</dimen>
    <!-- KM Basic touchpad: comfort gap under L/M/R; combined with nav insets in code (see fragment). -->
    <dimen name="basic_touchpad_content_inset_bottom">10dp</dimen>
    <!-- KM Pro composite touchpad: mouse row min height; compact layout uses same row with vertical orientation in code. -->
    <dimen name="pro_touchpad_mouse_row_min_height">76dp</dimen>
    <!-- When touchpad_section height is at or below this, use compact (pad | vertical L/M/R) layout. -->
    <dimen name="pro_touchpad_section_compact_height_threshold">232dp</dimen>
    <!-- KM Pro mouse-keys row: vertical padding (also used after resetting programmatic strip insets). -->
    <dimen name="pro_touchpad_mouse_keys_padding_top">6dp</dimen>
    <dimen name="pro_touchpad_mouse_keys_padding_bottom">4dp</dimen>
    <!-- Portrait NumPad + strip: horizontal inset for L/M/R column beside the pad. -->
    <dimen name="pro_touchpad_mouse_keys_strip_padding_horizontal">8dp</dimen>
    <!-- Landscape split + strip: extra inset before L and after R when L/M/R is a horizontal row. -->
    <dimen name="pro_touchpad_mouse_keys_split_horizontal_edge_inset">10dp</dimen>
    <!-- KM Pro composite: vertical wheel strip beside pad (split / NumPad narrow columns). -->
    <dimen name="pro_touchpad_scroll_strip_min_width">30dp</dimen>
    <!-- Per-key margins (inflateKey sets LayoutParams); adjacent keys sum to horizontal/vertical gap. -->
    <dimen name="basic_keyboard_key_margin_h">1dp</dimen>
    <dimen name="basic_keyboard_key_margin_v">2dp</dimen>
    <dimen name="basic_keyboard_arrow_icon_size">22dp</dimen>
    <!-- KM Basic: floating label above/below key on press -->
    <dimen name="basic_key_preview_corner_radius">9dp</dimen>
    <dimen name="basic_key_preview_padding_h">16dp</dimen>
    <dimen name="basic_key_preview_padding_v">12dp</dimen>
    <dimen name="basic_key_preview_min_size">44dp</dimen>
    <dimen name="basic_key_preview_text_size">24sp</dimen>
    <dimen name="basic_key_preview_gap">6dp</dimen>
    <dimen name="basic_key_preview_screen_margin">6dp</dimen>
    <dimen name="basic_key_preview_elevation">10dp</dimen>
    <!-- F1..F12: fixed component of horizontal preview shift (see BasicKeyPreview + key width scaling). -->
    <dimen name="basic_key_preview_f_row_max_shift">42dp</dimen>
    <!-- F-row: nudge preview further above the key when shown above (thumb clearance). -->
    <dimen name="basic_key_preview_f_row_extra_up">12dp</dimen>
    <!-- Compose: top shortcut strip only (~same share of keyboard as Keyboard+Mouse portrait: 2.4 / (2.4 + 4 letter rows) of keyboard band) -->
    <dimen name="compose_shortcut_strip_height">120dp</dimen>
    
    <!-- Touchpad -->
    <dimen name="touchpad_corner_radius">12dp</dimen>
    <dimen name="touchpad_elevation">2dp</dimen>
    <dimen name="touchpad_help_overlay_shift_up">-28dp</dimen>
    <dimen name="touchpad_help_overlay_shift_up_split">-20dp</dimen>
    <!-- Split touchpad: max hint width (portrait; matches composite portrait 340dp feel) -->
    <dimen name="touchpad_help_overlay_max_width_split">340dp</dimen>

    <!-- Toggle handle between touchpad and keyboard (portrait = height, landscape = narrow axis) -->
    <dimen name="toggle_handle_height">28dp</dimen>
    <dimen name="toggle_handle_width_landscape">24dp</dimen>

    <!-- KM Pro split landscape IME compose: vertical action rail width clamps (~9:1 target vs parent). -->
    <dimen name="split_compose_ime_rail_min_width">52dp</dimen>
    <dimen name="split_compose_ime_rail_max_width">96dp</dimen>
    
    <!-- Card -->
    <dimen name="card_corner_radius">12dp</dimen>
    <dimen name="card_elevation">3dp</dimen>

</resources>
