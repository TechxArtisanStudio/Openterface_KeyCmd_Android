<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyboardButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="FontStyle" parent="Theme.AppCompat.Light">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- New shortcut bottom sheet -->
    <style name="Widget.KeyMod.CreateShortcut.Modifier" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.KeyMod.CreateShortcut.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipMinHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="chipCornerRadius">22dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
    </style>

    <style name="Widget.KeyMod.CreateShortcut.Chip.Small" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipMinHeight">40dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
    </style>

    <!-- Favorites reorder sheet visual alignment with New Shortcut -->
    <style name="TextAppearance.KeyMod.SectionCaption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.KeyMod.Favorites.Action.Secondary" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.KeyMod.Favorites.Action.Tertiary" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.KeyMod.Favorites.Action.Primary" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Shortcut Hub profile detail: tabs match Material, no forced all-caps -->
    <style name="TextAppearance.KeyMod.HubTab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.KeyMod.HubHeaderButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="KbMouseSubmodeTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/nav_item_background_selector</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- KM Pro header submode: icon tabs, same pill background as Basic text tabs. -->
    <style name="KmProSubmodeTabIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/nav_item_background_selector</item>
        <item name="android:tint">@color/km_pro_submode_tab_icon_tint</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.KeyMod.BasicNumpadCell" parent="@android:style/Widget.TextView">
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textColor">@color/basic_key_label_color</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- Numpad direction keys: flat name avoids dotted-style implicit parent; icon + tint in layout. -->
    <style name="KeyModBasicNumpadIconCell">
        <item name="android:background">@drawable/key_background</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.KeyMod.BasicTouchpadMouseButton" parent="Widget.KeyMod.BasicNumpadCell">
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- KM Pro touchpad L/M/R row: same visuals as Basic mouse row; separate name for Pro call sites. -->
    <style name="Widget.KeyMod.ProTouchpadMouseButton" parent="Widget.KeyMod.BasicTouchpadMouseButton" />

    <style name="Widget.KeyMod.BasicComposeActionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Gamepad stick / button module configuration dialogs (aligned with touchpad presentation card) -->
    <style name="TextAppearance.KeyMod.GamepadConfig.SheetTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.KeyMod.GamepadConfig.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.KeyMod.GamepadConfig.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.KeyMod.GamepadConfig.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- KM Basic IME compose: same surface tier as keys; theme text/hint for day/night + accent themes.
         Explicit parent avoids AAPT inferring non-existent Widget.KeyMod.BasicCompose / Widget.KeyMod. -->
    <style name="Widget.KeyMod.BasicComposeEditor" parent="@android:style/Widget.EditText">
        <item name="android:background">@drawable/basic_compose_editor_background</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">top|start</item>
    </style>

</resources>