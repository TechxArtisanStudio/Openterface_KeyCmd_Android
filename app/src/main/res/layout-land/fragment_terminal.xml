<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/terminal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_background">

    <!-- Top status bar (compact for landscape) -->
    <LinearLayout
        android:id="@+id/terminal_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/terminal_toolbar_background"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Left side: submode tabs -->
        <LinearLayout
            android:id="@+id/terminal_submode_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/terminal_tab_keyboard"
                style="@style/KmProSubmodeTabIcon"
                android:contentDescription="@string/terminal_submode_keyboard"
                android:src="@drawable/ic_km_pro_submode_keyboard" />

            <ImageButton
                android:id="@+id/terminal_tab_compose"
                style="@style/KmProSubmodeTabIcon"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/terminal_submode_compose"
                android:src="@drawable/ic_km_pro_submode_compose" />
        </LinearLayout>

        <!-- Connection status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/terminal_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terminal_disconnected"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/terminal_host_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right side: connect button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_connect_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/terminal_connect"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Horizontal layout: left keyboard | terminal | right keyboard -->
    <LinearLayout
        android:id="@+id/terminal_split_root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left keyboard column (weight=0 when hidden, weight=1 when split) -->
        <LinearLayout
            android:id="@+id/terminal_split_left_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/terminal_split_top_left"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.openterface.keymod.CustomKeyboardView
                android:id="@+id/terminal_keyboard_view_left"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2.2"
                android:paddingTop="@dimen/keyboard_outer_padding_top"
                android:paddingBottom="@dimen/keyboard_outer_padding_bottom"
                android:keyBackground="@drawable/key_background"
                android:theme="@style/ButtonTheme"
                app:showGuiHidKey="false" />

        </LinearLayout>

        <!-- Center terminal column (weight=1 when hidden/fullscreen, weight=2 when split) -->
        <FrameLayout
            android:id="@+id/terminal_display_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/terminal_background">

            <com.openterface.terminal.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Connection overlay (shown when disconnected) -->
            <LinearLayout
                android:id="@+id/terminal_connection_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/terminal_background"
                android:visibility="gone"
                android:paddingStart="12dp"
                android:paddingTop="16dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_terminal"
                    android:tint="@color/text_secondary"
                    android:importantForAccessibility="no"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/top_mode_label_terminal"
                    android:textSize="16sp"
                    android:textColor="@color/terminal_status_text"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="240dp"
                    android:text="@string/top_mode_label_terminal_summary"
                    android:textSize="12sp"
                    android:textColor="@color/terminal_status_text"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Right keyboard column (weight=0 when hidden, weight=1 when split) -->
        <LinearLayout
            android:id="@+id/terminal_split_right_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/terminal_split_top_right"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.openterface.keymod.CustomKeyboardView
                android:id="@+id/terminal_keyboard_view_right"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2.2"
                android:paddingTop="@dimen/keyboard_outer_padding_top"
                android:paddingBottom="@dimen/keyboard_outer_padding_bottom"
                android:keyBackground="@drawable/key_background"
                android:theme="@style/ButtonTheme"
                app:showGuiHidKey="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Compose editor container (shown in compose submode, at bottom in landscape) -->
    <!-- Matches KM Pro's BasicComposeFragment layout structure -->
    <LinearLayout
        android:id="@+id/terminal_compose_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/background_light"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <!-- Editor: fixed height, scrollable -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/basic_compose_editor_min_height"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <EditText
                android:id="@+id/terminal_compose_editor"
                style="@style/Widget.KeyCmd.BasicComposeEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/terminal_compose_hint"
                android:minHeight="@dimen/basic_compose_editor_min_height"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="1"
                android:scrollbars="vertical"
                android:gravity="top|start"
                android:importantForAutofill="no" />

        </androidx.core.widget.NestedScrollView>

        <!-- Action buttons row - same layout as KM Pro -->
        <LinearLayout
            android:id="@+id/terminal_compose_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_compose_clear"
                style="@style/Widget.KeyCmd.BasicComposeActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/terminal_compose_clear_cd"
                android:text=""
                app:icon="@drawable/ic_compose_clear_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_compose_library"
                style="@style/Widget.KeyCmd.BasicComposeActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/terminal_compose_library_cd"
                android:text=""
                app:icon="@drawable/ic_bookmark_star_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_compose_save"
                style="@style/Widget.KeyCmd.BasicComposeActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/ime_saved_text_save_cd"
                android:text=""
                app:icon="@drawable/ic_top_save"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/terminal_compose_send"
                style="@style/Widget.KeyCmd.BasicComposeActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
                android:gravity="center"
                android:contentDescription="@string/terminal_compose_send"
                android:text=""
                app:icon="@drawable/ic_compose_send_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Shortcut strip (same as full keyboard) -->
        <FrameLayout
            android:id="@+id/terminal_compose_shortcut_strip_wrap"
            android:layout_width="match_parent"
            android:layout_height="@dimen/compose_shortcut_strip_height"
            android:layout_marginStart="@dimen/basic_compose_km_pro_shortcut_strip_horizontal_outdent"
            android:layout_marginEnd="@dimen/basic_compose_km_pro_shortcut_strip_horizontal_outdent"
            android:layout_marginTop="2dp">

            <com.openterface.keymod.CustomKeyboardView
                android:id="@+id/terminal_compose_shortcut_strip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="@dimen/keyboard_outer_padding_top"
                android:paddingBottom="@dimen/keyboard_outer_padding_bottom"
                android:keyBackground="@drawable/key_background"
                android:theme="@style/ButtonTheme"
                app:showGuiHidKey="false" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
