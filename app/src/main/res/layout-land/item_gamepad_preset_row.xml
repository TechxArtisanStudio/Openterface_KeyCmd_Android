<?xml version="1.0" encoding="utf-8"?>
<!-- Tighter row for narrow landscape preset panel: smaller icon targets, single-line title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_small"
    android:paddingVertical="4dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/preset_row_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:visibility="invisible"
        app:srcCompat="@drawable/ic_check"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/preset_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/preset_row_save"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/gamepad_preset_row_save_cd"
        android:padding="8dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/save_24"
        app:tint="?android:attr/textColorSecondary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/preset_row_delete"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/gamepad_preset_row_delete_cd"
        android:padding="8dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/delete_24"
        app:tint="?android:attr/textColorSecondary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/preset_row_share"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/gamepad_preset_row_share_cd"
        android:padding="8dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/share_24"
        app:tint="?android:attr/textColorSecondary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/preset_row_overflow"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/gamepad_preset_row_menu_cd"
        android:padding="8dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_menu"
        app:tint="?android:attr/textColorSecondary" />
</LinearLayout>
