<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: left column = title + subtitle + checkbox + buttons. Right = mode grid (order matches nav_menu). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launch_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:background="@color/background_light">

    <!-- Left: copy + actions under it (top-aligned so the grid has the full right pane) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="10"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/launch_panel_welcome_prefix"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="4dp"
                    android:maxWidth="280dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_keycmd_wordmark"
                    android:tint="@color/launch_panel_brand_tint" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/launch_panel_land_subtitle"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.1" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <CheckBox
                android:id="@+id/remember_choice_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/launch_panel_remember_choice"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/start_button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:text="@string/launch_panel_start"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/button_blue_bg"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/skip_button"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:text="@string/launch_panel_skip"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:background="@drawable/button_skip_bg"
                android:stateListAnimator="@null" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2" />

        </LinearLayout>
    </LinearLayout>

    <!-- Right: scrollable grid + tutorial + credit -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingStart="2dp"
        android:paddingEnd="6dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:fillViewport="true"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="22dp"
            android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="2"
            android:padding="@dimen/launch_panel_land_grid_padding"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false">

            <androidx.cardview.widget.CardView
                android:id="@+id/keyboard_mouse_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/launch_panel_land_card_margin"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/launch_panel_land_card_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/launch_panel_land_card_padding_h"
                    android:paddingVertical="@dimen/launch_panel_land_card_padding_v"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background_selector">

                    <ImageView
                        android:layout_width="@dimen/launch_panel_land_card_icon"
                        android:layout_height="@dimen/launch_panel_land_card_icon"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/keyboard_mouse"
                        android:contentDescription="@string/top_mode_label_keyboard_mouse"
                        android:tint="@color/card_icon_tint" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/top_mode_label_keyboard_mouse"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/card_text_color"
                        android:gravity="center"
                        android:maxLines="3" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/keyboard_mouse_pro_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/launch_panel_land_card_margin"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/launch_panel_land_card_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/launch_panel_land_card_padding_h"
                    android:paddingVertical="@dimen/launch_panel_land_card_padding_v"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background_selector">

                    <ImageView
                        android:layout_width="@dimen/launch_panel_land_card_icon"
                        android:layout_height="@dimen/launch_panel_land_card_icon"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/keyboard_mouse_pro"
                        android:contentDescription="@string/top_mode_label_keyboard_mouse_pro"
                        android:tint="@color/card_icon_tint" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/top_mode_label_keyboard_mouse_pro"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/card_text_color"
                        android:gravity="center"
                        android:maxLines="3" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/presentation_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/launch_panel_land_card_margin"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/launch_panel_land_card_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/launch_panel_land_card_padding_h"
                    android:paddingVertical="@dimen/launch_panel_land_card_padding_v"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background_selector">

                    <ImageView
                        android:layout_width="@dimen/launch_panel_land_card_icon"
                        android:layout_height="@dimen/launch_panel_land_card_icon"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_presentation"
                        android:contentDescription="@string/presentation_mode"
                        android:tint="@color/card_icon_tint" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/presentation_mode"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/card_text_color"
                        android:gravity="center"
                        android:maxLines="2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/gamepad_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="3"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/launch_panel_land_card_margin"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/launch_panel_land_card_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/launch_panel_land_card_padding_h"
                    android:paddingVertical="@dimen/launch_panel_land_card_padding_v"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background_selector">

                    <ImageView
                        android:layout_width="@dimen/launch_panel_land_card_icon"
                        android:layout_height="@dimen/launch_panel_land_card_icon"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gamepad"
                        android:contentDescription="@string/top_mode_label_gamepad"
                        android:tint="@color/card_icon_tint" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/top_mode_label_gamepad"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/card_text_color"
                        android:gravity="center"
                        android:maxLines="2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/shortcuts_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/launch_panel_land_card_margin"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/launch_panel_land_card_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/launch_panel_land_card_padding_h"
                    android:paddingVertical="@dimen/launch_panel_land_card_padding_v"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background_selector">

                    <ImageView
                        android:layout_width="@dimen/launch_panel_land_card_icon"
                        android:layout_height="@dimen/launch_panel_land_card_icon"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/shortcuts_hub"
                        android:contentDescription="@string/top_mode_label_shortcuts"
                        android:tint="@color/card_icon_tint" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/top_mode_label_shortcuts"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/card_text_color"
                        android:gravity="center"
                        android:maxLines="2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/top_mode_label_shortcuts_summary"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:maxLines="2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/macros_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/launch_panel_land_card_margin"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/launch_panel_land_card_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/launch_panel_land_card_padding_h"
                    android:paddingVertical="@dimen/launch_panel_land_card_padding_v"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background_selector">

                    <ImageView
                        android:layout_width="@dimen/launch_panel_land_card_icon"
                        android:layout_height="@dimen/launch_panel_land_card_icon"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/macros"
                        android:contentDescription="@string/top_mode_label_macros"
                        android:tint="@color/card_icon_tint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/top_mode_label_macros"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/card_text_color"
                            android:maxLines="2" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_experiment_24px"
                            android:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/top_mode_label_macros_summary"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:maxLines="2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/terminal_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/launch_panel_land_card_margin"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/launch_panel_land_card_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/launch_panel_land_card_padding_h"
                    android:paddingVertical="@dimen/launch_panel_land_card_padding_v"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background_selector">

                    <ImageView
                        android:layout_width="@dimen/launch_panel_land_card_icon"
                        android:layout_height="@dimen/launch_panel_land_card_icon"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/terminal"
                        android:contentDescription="@string/top_mode_label_terminal"
                        android:tint="@color/card_icon_tint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/top_mode_label_terminal"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/card_text_color"
                            android:maxLines="1" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_experiment_24px"
                            android:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/top_mode_label_terminal_summary"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:maxLines="2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/agent_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="3"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/launch_panel_land_card_margin"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/launch_panel_land_card_min_height"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/launch_panel_land_card_padding_h"
                    android:paddingVertical="@dimen/launch_panel_land_card_padding_v"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background_selector">

                    <ImageView
                        android:layout_width="@dimen/launch_panel_land_card_icon"
                        android:layout_height="@dimen/launch_panel_land_card_icon"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/agent"
                        android:contentDescription="@string/top_mode_label_agent"
                        android:tint="@color/card_icon_tint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/top_mode_label_agent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/card_text_color"
                            android:maxLines="2" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_experiment_24px"
                            android:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/top_mode_label_agent_summary"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:maxLines="2" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>

        <TextView
            android:id="@+id/show_tutorial_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/show_tutorial_link"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/launch_panel_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="20dp"
            android:gravity="center_horizontal"
            android:text="@string/launch_panel_credit"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:textColorLink="?attr/colorPrimary"
            android:autoLink="web"
            android:lineSpacingMultiplier="1.15" />

        </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</LinearLayout>
